		SetBonuses: {
			NeroSet:
				'''
				Grants the ability to freely move through water
				Increases whip range by 40%
				Increases movement speed by 15% and defense by 10 when submerged in liquid
				Press the Armor Ability hotkey to place a Nero Construct at the cursor position
				Press the hotkey again will remove the construct
				'''
			SinnerSet:
				'''
				All magic attacks inflict Frostburn
				Increases mana regeneration
				Reduces mana cost by 14%
				'''
			MushiumSet:
				'''
				Increases max number of sentries by 1
				Press the Armor Ability hotkey to swap modes
				After switching, you have to wait 30 seconds before being able to switch again
				[c/c63434:Scarlet mode]:
				Increases life regeneration by 3
				Increases defense by 4
				Swapping to Scarlet mode will heal 10 health and grant increased life regeneration on enemy hits for 5 seconds
				[c/0080ff:Indigo mode]:
				Increases mana regeneration by 3
				Increases critical strike chance by 7%
				Decreases defense by 6
				Swapping to Indigo mode will increase damage by 20% 5 seconds.
				'''
		}

		"Keybinds.Armor Ability.DisplayName": Armor Ability

		Configs: {
			MDConfig: {
				DisplayName: General config

				NPCItemSelling: {
					Label: Town NPC Item selling
					Tooltip: NPCs sell new items
				}

				ALTitleCards: {
					Label: AL Title Cards
					Tooltip: Vanilla and Awakened Light bosses and some biomes will display a title card upon being spawned/entered.
				}

				ScreenshakeDisable: {
					Label: Disable Screenshakes
					Tooltip: Disables all instances of screenshakes within the mod.
				}

				VanillaBestiaryRewrite: {
					Label: Vanilla Bestiary Rewrite
					Tooltip: Rewrites various vanilla Bestiary entries to fit into Awakened Light lore.
				}
			}

