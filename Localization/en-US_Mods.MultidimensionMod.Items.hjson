FortunePearl: {
	DisplayName: Fortune Pearl
	Tooltip: Very rare green pearl that was thought to be a mere myth
}

DragonToothItem: {
	DisplayName: Dragon Tooth
	Tooltip:
		'''
		An herb found in the Dragon's Hoard.
		Despite being a small grass blade-like plant,
		the outer epidermis of this species is so thick that it can pierce someone's foot if they step on it.
		'''
	BloomTip:
		'''
		The small orange receptors on this herb react to harsh sunlight,
		as such, this herb blooms only during the hours the sun is at its zenith.
		'''
}

DreamLilyItem: {
	DisplayName: Dream Lily
	Tooltip:
		'''
		An herb found in the Shrouded Mire.
		This rare lily is said to reveal the sweetest dreams in a sleep eternal.
		Contains a powerful drug that was often used in medication to lull the ill to sleep.
		'''
	BloomTip: This nocturnal flower is most comfortable during the midnight hours, during which it will bloom.
}

DragonToothSeeds: {
	DisplayName: Dragon Tooth Seeds
	Tooltip: ""
}

DreamLilySeeds: {
	DisplayName: Dream Lily Seeds
	Tooltip: ""
	Lore:
		'''
		In Ryomare, people believed that these lilies were bestowed upon their land by a saint who is often referred to as the 'Gentle Daydream'.
		History books tell the story of a girl who was in a state of perpetual sleep, but with the ability to interact with the world as if she was awake.
		'''
}

HiveNugget: {
	DisplayName: Hive Nugget
	Tooltip:
		'''
		Grants the honey buff while not moving and not using weapons
		You can walk on honey blocks and swim through honey without being slowed down
		'''
}

EggPouch: {
	DisplayName: Egg Pouch
	Tooltip:
		'''
		An eggsack retrieved from a spider's body
		Causes spider hatchlings to burst out of you every 5 seconds that deal summon damage
		Hatchlings poison enemies on hit
		'''
}

ShaleBrick: {
	DisplayName: Shale Brick
	Tooltip:
		'''
		Grants immunity to knockback and Mighty Wind
		Weighs you down heavily in water
		'''
}

TheBrick: {
	DisplayName: The Brick
	Tooltip:
		'''
		Reduces knocback by 50%
		Weighs you down while in water
		'''
}

AidenPlushie: {
	DisplayName: Aiden Plushie
	Tooltip: A cuddly plushie designed after the star destroyer.
}

CultissimaPlushie: {
	DisplayName: Cultissima Plushie
	Tooltip: A cuddly plushie designed after the smartest little cookie.
}

KarvolisPlushie: {
	DisplayName: Karvolis Plushie
	Tooltip: A cuddly plushie designed after the oldest starborn.
}

KuruPlushie: {
	DisplayName: Kuru Plushie
	Tooltip: A cuddly plushie designed after the collected fighter.
}

PsyrobnikPlushie: {
	DisplayName: Psyrobnik Plushie
	Tooltip: A cuddly plushie designed after the robotic mastermind.
}

VeronicaPlushie: {
	DisplayName: Veronica Plushie
	Tooltip: A cuddly plushie designed after the viral empress.
}

ZetPlushie: {
	DisplayName: Zet Plushie
	Tooltip: A cuddly plushie designed after the special agent.
}

StoneDart: {
	DisplayName: Stone Dart
	Tooltip: Slow but steady
}

StarfeatherDart: {
	DisplayName: Starfeather Dart
	Tooltip: Not affected by gravity and pierces up to 5 times
}

BambooPowder: {
	DisplayName: Bamboo Powder
	Tooltip: Bamboo from the jungle ground into a fine powder
}

PumpkinSoup: {
	DisplayName: Pumpkin Soup
	Tooltip: ""
}

GourmetTruffle: {
	DisplayName: Gourmet Truffle
	Tooltip:
		'''
		Rare truffle only found within the scarlet mycelium forest
		Is often dug up by spore puffers or found sticking to mushroom slimes
		'''
}

KiBa: {
	DisplayName: KiBa
	Tooltip: ""
}

RoyalTruffleSoup: {
	DisplayName: Royal Truffle Soup
	Tooltip: ""
}

Toadstool: {
	DisplayName: Toadstool
	Tooltip: Fungus
}

TruffleSoup: {
	DisplayName: Truffle Soup
	Tooltip: The larvae and truffle delicously melt within the hovercap juice broth, making for a unique texture
}

WyvernMilk: {
	DisplayName: Wyvern Milk
	Tooltip: Nature always finds a way.
}

AurealisMead: {
	DisplayName: Aurealis Mead
	Tooltip:
		'''
		The main event of every viking ritual
		It is consumed as a small sip by everyone attending from a hollowed out horn,
		to form eternal bonds with eachother and with the drakes.
		'''
}

BottledDrakeSaliva: {
	DisplayName: Bottled Drake Saliva
	Tooltip:
		'''
		Some might think of this as disgusting, yet in Drakenheim it was like holy water.
		It's a main ingredient for important rituals.
		'''
}

Rimeberry: {
	DisplayName: Rimeberry
	Tooltip:
		'''
		Sweet berries that are native only to the Drakenheim tundra.
		Snow layered on top are mixed with excreted fruit juices.
		'''
}

RimeberryAle: {
	DisplayName: Rimeberry Ale
	Tooltip: One of the everyday drinks a viking would consume during and after work.
}

WinterHoney: {
	DisplayName: Winter Honey
	Tooltip:
		'''
		The honey from yeti bees has a one of a kind texture
		No wonder it was once wanted by every country even beyond the continent
		'''
}

FriendshipBracelet: {
	DisplayName: Friendship Bracelet
	Tooltip: Increases defense by 4 for every used minion slot
}

Woodfisk: {
	DisplayName: Wooden Flatfish
	Tooltip: Caught in Purity
	QuestDialogue: Hey buddy, my last cutting board somehow broke and now I need a new one. Of course I don't want any old cutting board, this one may be a bit fishy. I heard that around the forest lakes you can find a flat fish made entirely of wood. Probably got hit by some sort of wood Medusa. I don't care how or why, but I want it right now!
}

SmolderingShaleplate: {
	DisplayName: Smoldering Shaleplate
	Tooltip:
		'''
		Partially molten shalestone that forms in clusters within superheated pockets
		Useful material for smelting and forging
		'''
}

Glimmerstar: {
	DisplayName: Glimmerstar
	Tooltip: Conjurs smaller glimmer stars that spiral outwards and inwards
}

TruffleThrow: {
	DisplayName: Truffle Throw
	Tooltip: Afungus
}

BurstKunai: {
	DisplayName: Burst Kunai
	Tooltip: Sticks to enemies and explodes after a short delay
}
