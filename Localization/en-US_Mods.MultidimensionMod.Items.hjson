Shinorian: {
	DisplayName: Hex Rapier
	Tooltip:
		'''
		Inflicts Accused
		Cursed enemies are haunted by ghosts
		'''
	Lore:
		'''
		A cursed thrusting sword empowered by malicious runes.
		The curses laid onto this weapon are ancient and have no counterspell,
		the hex isn't at its peak though and as such won't be able to cause any major harm.

		Some say that this weapon was crafted out of spite against all life,
		far far away in a dimension known as Arinetos.
		Its ancient people had the darkest thoughts and desires, thoughts that had ultimately killed them,
		even before their brethren from the glorious capital.
		'''
}

TheFly: {
	DisplayName: The Fly
	Tooltip: Swarm your foes with flies like flies swarm a rotting corpse.
}

TundranaScythe: {
	DisplayName: Tundrana Scythe
	Tooltip: Shoots rotating ice sickles
	Lore:
		'''
		This weaponry was used by Royal Reaper Guards of the Subzero Ridge,
		a world from beyond the freezing fog of the Frozen Underworld.
		It has lost most of its power over time.
		'''
}

Vulkanus: {
	DisplayName: Evil Ember, Vulkanus
	Tooltip:
		'''
		Throw a blade of molten rock, the blade explodes into volcanic rocks on impact
		The blade inflicts Blazing Suffering
		'''
	Talk:
		'''
		[c/ff8000:Thanks for picking me up by the way.]
		[c/ff8000:This punk thinks we killed his lord even though we didn't do anything like that.]
		[c/ff8000:And even then, it was HIS lord who started these pointless fights against us.]
		[c/ff8000:If I see this guy ever again, I swear I'm gonna lose it]
		'''
}

