Pyrosphere: {
	DisplayName: Pyrosphere
	Tooltip:
		'''
		When the flail reaches its maximum reach,
		the chain will break and launch the sphere as an explosive
		'''
	Lore:
		'''
		This flail was once carved from the very volcano the dragons now call home,
		the embers within will begin to heat up if it is swung fast enough.
		It seems like it has seen better days, only remnants of its flames remain,
		and claw marks from whoever brought it into the volcanic caverns have damaged it more.
		'''
}

DragonsGuard: {
	DisplayName: Dragon's Guard
	Tooltip:
		'''
		Being inflicted with On Fire! will fuel your very soul with power
		While being empowered, you gain 10 defense and 8% increased damage
		Any enemy touching you will be set ablaze
		'''
	Lore:
		'''
		This dragon head shaped shield was never intended for combat,
		its purpose was to be used in ceremonial play.
		It depicts the draconian demon that the people of this land feared.
		'''
}

OrnateBand: {
	DisplayName: Ornate Band
	Tooltip:
		'''
		Casts a protective veil that absorbs a damage based debuff once
		After absorbing a debuff, the veil disappears and inflicts the debuff onto all nearby enemies.
		The veil reappears after 20 seconds
		Life regeneration is increased by 4 for 5 seconds after the veil disappeared
		'''
	Lore:
		'''
		Wristbands like these were once bestowed upon shrine maidens who tend to the seal,
		they were supposed to protect the wearer from demonic influence coming from deep down in the volcano.
		However, the seal was undone, incinerated by the roar of the erupting volcano and with it, its people.
		What was once a mere myth, became reality.
		'''
}

CuriousClaw: {
	DisplayName: Warped Claw
	Tooltip: Summons the Grips of Chaos at night
}

ClawOfChaos: {
	DisplayName: Gripclaw Effigy
	Tooltip:
		'''
		Grappling hooks pull 30% faster
		Hooks that touch enemies inflict Poisoned and On Fire!
		'''
}

