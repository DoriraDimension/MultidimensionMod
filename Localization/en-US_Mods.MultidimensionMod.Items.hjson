EGG: {
	#Divine Egg
	DisplayName: 01000100 01101001 01110110 01101001 01101110 01100101 00100000 01000101 01100111 01100111
	#Lonely
	#Angry
	#Bitter
	#Forgotten
	#The greater good
	Tooltip:
		'''
		01001100 01101111 01101110 01100101 01101100 01111001
		01000001 01101110 01100111 01110010 01111001
		01000010 01101001 01110100 01110100 01100101 01110010
		01000110 01101111 01110010 01100111 01101111 01110100 01110100 01100101 01101110
		01010100 01101000 01100101 00100000 01100111 01110010 01100101 01100001 01110100 01100101 01110010 00100000 01100111 01101111 01101111 01100100
		'''
	#Do not wake the
	#sleeping gods
	FuckOffText:
		'''
		01000100 01101111 00100000 01101110 01101111 01110100 00100000 01110111 01100001 01101011 01100101 00100000 01110100 01101000 01100101
		01110011 01101100 01100101 01100101 01110000 01101001 01101110 01100111 00100000 01100111 01101111 01100100 01110011
		'''
	#A moment of
	#eternity
	FuckOffText2:
		'''
		01000001 00100000 01101101 01101111 01101101 01100101 01101110 01110100 00100000 01101111 01100110
		01100101 01110100 01100101 01110010 01101110 01101001 01110100 01111001
		'''
}

Sunpowder: {
	DisplayName: Sunpowder
	Tooltip:
		'''
		Throw a bag of smoldering powder that inflicts Mild Burn
		Mild Burn decreases defense by 10
		The debuff cannot be applied if the enemy is under the effect of Moonpowder
		or is already inflicted with Mild Burn
		'''
}

Moonpowder: {
	DisplayName: Moonpowder
	Tooltip:
		'''
		Throw a bag of drugged powder that inflicts Hazed
		Hazed decreases enemy damage by 15%
		The debuff cannot be applied if the enemy is under the effect of Sunpowder
		or is already inflicted with Hazed
		'''
}

AncientSwordArt: {
	DisplayName: Ancient Sword Art: Brilliant Gems
	Tooltip: Conjures sword apparitions in all gem colors at the cursor position
}

AwakenedRock: {
	DisplayName: Awakened Rock
	Tooltip:
		'''
		This type of stone was created by a massive outburst of chaotic energy
		It was changed similar to the rest of the environment, but to a much worse degree
		You can hear eerie droning coming from the stone
		'''
}

GildedTilesItem: {
	DisplayName: Gilded Pagoda Shingles
	Tooltip: ""
}

PagodaBrick: {
	DisplayName: Pagoda Brick
	Tooltip: ""
}

PagodaColumn: {
	DisplayName: Pagoda Column
	Tooltip: ""
}

PagodaFloor: {
	DisplayName: Pagoda Floor Tile
	Tooltip: ""
}

AbyssGrassSeeds: {
	DisplayName: Nightmare Grass Seeds
	Tooltip: Blood red grass that only grows on the island in the Shrouded Mire
}

MirrorOfOrigin: {
	DisplayName: Mirror of Origin
	Tooltip: Reveals which items have a unique shimmer transmutation while in the inventory
	Lore:
		'''
		The mysterious shimmer possesses infinite capabilities, but seems to be oddly restricted at the same time.
		A substance that can transform objects and lifeforms alike into something else,
		reminiscent of a dna helix that defines what a being will be.
		Maybe it is nature itself manifest, from concept to a present will.
		'''
}

ImpactTreads: {
	DisplayName: Impact Treads
	Tooltip:
		'''
		Allows flight, negates fall damage and grants immunity to fire blocks
		Increases fall speed and maximum fall speed by 15%
		Increases defense by 6 while falling fast
		Falling fast enough and hitting the ground will create a short lived shockwave
		'''
}

InvigoratingMushroom: {
	DisplayName: Invigorating Mushroom
	Tooltip: Increases max life by 20
}

AdvancedFishingLicense: {
	DisplayName: Advanced Fishing License
	Tooltip:
		'''
		A license, showing proof of being one of greatest fishermen in the world
		Increases the amount of Angler Quests per day by one
		Only one may be used
		'''
}

ShimmerCarp: {
	DisplayName: Shimmering Carp
	Tooltip:
		'''
		A beautiful iridescent carp
		Increases the amount of Angler Quests per day by one
		Only one may be used
		'''
}

FogLantern: {
	DisplayName: Defog Lantern
	Tooltip: Partially clears up the thick fog in the Shrouded Mire
}

SporePotItem: {
	DisplayName: Spore Pot
	Tooltip: You are not supposed to have this.
}

SporeStoneWall: {
	DisplayName: Spore Stone Wall
	Tooltip: ""
}

MyceliumWall: {
	DisplayName: Mycelium Wall
	Tooltip: ""
}

EyeoftheFisher: {
	DisplayName: Eye of the Fisher
	Tooltip:
		'''
		[c/ccb3e1:A true fisher knows the catch.]
		You always see which fish is biting the hook
		'''
	Lore:
		'''
		Many a fisher is misunderstood, shrugged off as an annoyance, or even seen as insane.
		But they, they know the truth, hidden beneath the waters, whispered by the aquatic beings.
		Maybe some day you will understand too.
		'''
}

EyeofthePurifier: {
	DisplayName: Eye of the Purifier
	Tooltip:
		'''
		[c/f776a8:A true pure one notices the impure at first glance.]
		Highlights infected blocks
		'''
	Lore:
		'''
		If one thinks they are pure and free from all filth they are mistaken,
		there is no such thing as true purity.
		So who goes to say those impure ones aren't pure in their own right?
		'''
}

HerbGuide: {
	DisplayName: Guide to Master Herbology
	Tooltip: Displays blooming conditions in herb tooltips while in your inventory
}

NatureGuide: {
	DisplayName: Guide to Understanding Nature
	Tooltip:
		'''
		Allows the collection of Vine Rope from vines
		Prevents you from hurting critters and accidentally destroying the environment while favorited in the inventory,
		or while accessory visibility is enabled while equipped
		Displays blooming conditions in herb tooltips while in your inventory
		'''
}

HydraTrishot: {
	DisplayName: Hydra Trishot
	Tooltip:
		'''
		Shoots 3 bullets at once in a spread
		The lower your health is, the more bullets will be shot
		'''
}

GunkWand: {
	DisplayName: Gunk Wand
	Tooltip:
		'''
		Shoots a gunk ball that grows over time
		The larger the ball is, the more damage it does
		'''
}

Depthwalker: {
	DisplayName: Depthwalker
	Tooltip: Throws out 3 yoyos at once that poison enemies on hit
}

ShimmerProofFishingHook: {
	DisplayName: Shimmerproof Fishing Hook
	Tooltip: Allows fishing in shimmer
}

HydraStaff: {
	DisplayName: Hydra Staff
	Tooltip: Summons a one headed hydra sentry that spits acoid bombs at enemies
}

Apocalyptite: {
	DisplayName: Eschatyte
	Tooltip: An ominous ore eminating a foreboding droning
}

BlackIce: {
	DisplayName: Black Ice
	Tooltip: ""
}

DoomSeeds: {
	DisplayName: Warped Seeds
	Tooltip: ""
}

Doomstone: {
	DisplayName: Charged Omenstone
	Tooltip: ""
}

DoomstoneB: {
	DisplayName: Warpstone
	Tooltip: ""
}

DustSnow: {
	DisplayName: Dust Snow
	Tooltip: ""
}

OroborosWood: {
	DisplayName: Oroboros Wood
	Tooltip: ""
}

Warpsand: {
	DisplayName: Warpsand
	Tooltip: ""
}

WarpsandHardened: {
	DisplayName: Hardened Warpsand
	Tooltip: ""
}

Warpsandstone: {
	DisplayName: Warpsandstone
	Tooltip: ""
}

MetallicSand: {
	DisplayName: Metallic Sand
	Tooltip: ""
}

PenroseFish: {
	DisplayName: Penrose Fish
	Tooltip: Caught in Aether
	QuestDialogue: Heya, I don't know who I'm using to call you right now but I want you to catch a uhm... fish? Yeah a fish. It's somewhere deep below in a cave with some gleamy liquid. Oh wait, this is the angler I should stay in character. Ahem. Go get me that thing so I can shove it into someones toilet.
}

SelfSimilarStarfish: {
	DisplayName: Self-Similar Starfish
	Tooltip: Caught in Aether
	QuestDialogue: I heard of a place called the Aether, some fairytale place with some fairytale powers. And a fairytale place must have some fairytale fish. There is this incredibly sharp one that could be perfect to use as a magic shuriken, so go to wonderland and get me that twinkle star!
}

ShieldedAetherfish: {
	DisplayName: Shielded Aetherfish
	Tooltip: ""
}

StargazerBass: {
	DisplayName: Stargazer Bass
	Tooltip: ""
}

TreasureClam: {
	DisplayName: Treasure Clam
	Tooltip:
		'''
		May contain a precious pearl
		Right click to dismantle
		'''
}

Iridul: {
	DisplayName: Iridul
	Tooltip: A rare gemstone that forms from excessive shimmer gas in the atmosphere.
}

FishroomMonarch: {
	DisplayName: Fishroom Monarch
	Tooltip: Caught in Scarlet Mycelium Forest
	QuestDialogue: There was once a mighty king, loyal were his servants, valiantly protecting their king. Though one day one deserted their duty, and as they were hunted down by the other servants, they fell into the cursed waters of the dark scarlet woods. They transformed into a scaled monstrosity and became known as the monarch of the cursed fish. Well, you are curious, so go check if it's real.
}

Pufftail: {
	DisplayName: Pufftail
	Tooltip: Caught in Scarlet Mycelium Forest
	QuestDialogue: *cough* You won't believe it, earlier I was poking some bugs for fun when that big brown fella walked up to me and blasted me with some gas. I fell right into the pond next to me only to be gassed once more by a swimming one. I'm still reeling from that gas cloud. I will go show them not to mess with me. With that I mean, you will go get that lethal gasser, so I can sell it to some company as gas bombs.
}

ScarletWetworm: {
	DisplayName: Scarlet Wetworm
	Tooltip:
		'''
		Dark murky worms that live in the deep red waters of the Scarlet Mycelium Forest
		They are regularly consumed by Spotted Capsters
		'''
}

SpottedCapster: {
	DisplayName: Spotted Capster
	Tooltip: A loyal member of a swarm who will follow their captain anywhere, even if they are lead straight to their deaths
}

SpottedCaptain: {
	DisplayName: Spotted Captain
	Tooltip: A leader of a capster swarm, relatively rare and might sell for good money
}

DarkStarfish: {
	DisplayName: Dark Starfish
	Tooltip: A starfish-like creature that twinkles like an evil star
}

EternalOroboros: {
	DisplayName: Eternal Oroboros
	Tooltip: Caught in Scrapyard
	QuestDialogue: There is this eel that thinks he is so smart and cool by imitating two cycle symbols in one go. It is such a poser, I tell you. I think the wall behind me would make a good spot for its ego.
}

GlitchFish: {
	DisplayName: Glitch Fish
	Tooltip: ""
	Lore:
		'''
		A dark aquatic lifeform encountered in the Void's Edge and the Scrapyard below.
		It seems to be made of some twisted energy, the instability caused by that makes it constantly fade in and out of reality.
		Must be handled with extreme caution as it contains enough power to destroy the entire continent when releasing its energy supply.
		'''
}

ScrapSearcher: {
	DisplayName: Scrap Searcher
	Tooltip: Caught in Scrapyard
	QuestDialogue: Over at that clouded ocean I saw some weird fish in the water. Upon closer inspection it was made of metal and kept trying to stick some random scrap to itself. That thing would make a good vaccuum cleaner for my room and I bet you love salvaging things. Don't worry, if it acts up, try a controlled shock.
}

DragonKoi: {
	DisplayName: Dragon Koi
	Tooltip: Caught in Dragon's Hoard
	QuestDialogue: I read in my Grand Book of our World's Fish that there exists a rare carp that was used as a pet by this cool city. It's said it will turn into a dragon when passing through some gates, so I want to throw one through my door to see if that works too. C'mon, I just want to ride a badass dragon.
}

HeatsparkGoldfish: {
	DisplayName: Heatspark Goldfish
	Tooltip:
		'''
		A small fish with white and blue scales, like a seething blue flame
		Seeks shelter from the ashen pollution at night
		'''
}

JadeArowana: {
	DisplayName: Jade Arowana
	Tooltip: Caught in Dragon's Hoard
	QuestDialogue: I've read that the most expensive fish around here is called a Jade Arowana. I need one to flex my "wealth" with my fishing buddies. Or maybe I open a farm with them and make millions. Get one and I'll share 10% of my farm earnings with you, let's be business buddies.
}

TuffCarp: {
	DisplayName: Tuff Carp
	Tooltip: ""
	Lore:
		'''
		A type of carp that lives in the ash polluted waters of the Dragon's Hoard.
		They primarily filter ash particles from the water during nighttime which helps keep it clean and drinkable during the day.
		The absorbed particles are used to form a protective shell around the fish's scales to defend itself from predators.
		They are closely related to the local Dragon Koi, likely an evolutionary offshoot.
		'''
}

BogfinKoi: {
	DisplayName: Bogfin Koi
	Tooltip: Caught in Shrouded Mire
	QuestDialogue: You know that ornamental carp from the volcanic region? Apperantly the former inhabitants did some trading and some ended up in the swamplands. Legends state that they can become mighty sea serpents if they pass through a submerged stone gate. I already placed my neighbor's door in a nearby pond, I just need the fish.
}

Miresquitofish: {
	DisplayName: Miresquitofish
	Tooltip: Caught in Shrouded Mire
	QuestDialogue: You know what everyone hates? That's right, mosquitos. You know what everyone hates more? GIANT mosquitos. But imagine something even worse, a giant mosquito that SWIMS. I've found exactly that, I just need someone to neutralize it, so I can do some funny pool pranks with it.
}

Mudskipper: {
	DisplayName: Mudskipper
	Tooltip: ""
	Lore:
		'''
		Amphibian fish that live in the Shrouded Mire.
		Their front fins function similar to arms, allowing the creature to skip across the muddy surface of the swamp.
		Some have apparently been observed being able to leap up into the air.
		'''
}

SpiritCrawfish: {
	DisplayName: Spirit Crawfish
	Tooltip:
		'''
		Unique crawfish that live in the Shrouded Mire
		These creatures are said to be attuned to the luminous dark moon itself, which drew many seasoned fishermen into the mist shrouded swamp.
		'''
}

BloomSnail: {
	DisplayName: Bloom Snail
	Tooltip: Caught in Harmony Caverns
	QuestDialogue: I prepared the perfect prank for some of my allergic friends. I need this snail that bears a flower on its back, it releases these funny pollen that tickle your nose when you squeeze it. Would you be so nice to catch one? Oh and don't be too slow, or it might outrun you.
}

HeartleafFlatfish: {
	DisplayName: Heartleaf Flatfish
	Tooltip:
		'''
		Rare type of flatfish only found in the Harmony Caverns.
		Unlike their desert dwelling cousins, these float on the water surface to imitate fallen leafes.
		'''
}

HerbalNibbler: {
	DisplayName: Herbal Nibbler
	Tooltip:
		'''
		A fish that consumes all kinds of different herbs to turn them into a unique spice
		Can be used for cooking
		'''
}

TheWhole: {
	DisplayName: The Whole
	Tooltip: Caught in Harmony Caverns
	QuestDialogue: You know love? I don't know anything about it, but I want to impress someone I like. So, there is this type of fish where the couple sticks together like glue, and my book said it symbolises loyalty or something. That one should work as a gift. Just catch one, the other will be stupid enough to follow the other.
}

TerraCrystalItem: {
	DisplayName: Crystal of Order
	Tooltip:
		'''
		A large chunk of crystalized order energy.
		Formed during a heavy impact.
		'''
}

